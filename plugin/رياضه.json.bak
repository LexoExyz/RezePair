import baileys from '@whiskeysockets/baileys'
import { createRequire } from 'module'
const require = createRequire(import.meta.url)
const sportData = require('../src/data/رياضه.json')

const { generateWAMessageFromContent, proto, prepareWAMessageMedia } = baileys

let sportGames = new Map()

const SPORT_IMAGE = "https://files.catbox.moe/w8ycz1.jpg" // صورة افتراضية (يمكنك تغييرها)
const reward = 20
const gameTime = 30000 // 30 ثانية للإجابة

let handler = async (m, { conn, text, usedPrefix, command }) => {
    let chatId = m.chat
    let senderId = m.sender

    // 1. معالجة التحقق من الإجابة عبر الأزرار
    if (text.includes('check_sport|')) {
        let game = sportGames.get(chatId)
        if (!game) return 
        
        let [_, userChoice, correctResponse] = text.split('|')

        if (userChoice.trim() === correctResponse.trim()) {
            clearTimeout(game.timeoutId)
            sportGames.delete(chatId)
            let info = `✅ *إجابة صحيحة يا اسطورة الرياضة!* 🎉\n🎯 الإجابة: *${correctResponse}*\n🏆 الفائز المميز: @${senderId.split('@')[0]}\n📊 المكافأة: +${reward} نقطة`
            return conn.reply(chatId, info, fkontak, rcanal, { mentions: [senderId] })
        } else {
            game.attempts -= 1
            if (game.attempts > 0) {
                let info = `❌ *إجابة خاطئة!* باقي معك محاولة واحدة ⏳`
                return conn.reply(chatId, info, fkontak, rcanal)
            } else {
                clearTimeout(game.timeoutId)
                sportGames.delete(chatId)
                let info = `💀 *انتهت المحاولات!* الإجابة الصحيحة كانت: *${correctResponse}*`
                return conn.reply(chatId, info, fkontak, rcanal)
            }
        }
    }

    // 2. معالجة الانسحاب
    if (text === 'انسحاب_رياضه') {
        let game = sportGames.get(chatId)
        if (!game) {
            let info = '❌ لا توجد لعبة رياضية جارية حالياً.'
            return conn.reply(chatId, info, fkontak, rcanal)
        }
        clearTimeout(game.timeoutId)
        sportGames.delete(chatId)
        let info = `🚪 انسحبت! الإجابة الصحيحة كانت: *${game.currentSport.response}*`
        return conn.reply(chatId, info, fkontak, rcanal)
    }

    if (sportGames.has(chatId)) {
        let info = '⚠️ توجد لعبة رياضية جارية بالفعل في هذه الدردشة!'
        return conn.reply(chatId, info, fkontak, rcanal)
    }

    // 3. بدء جولة رياضة جديدة
    try {
        if (!sportData || sportData.length === 0) {
            let info = '❌ ملف بيانات الرياضة غير متوفر أو فارغ.'
            return conn.reply(chatId, info, fkontak, rcanal)
        }

        const selectedSport = sportData[Math.floor(Math.random() * sportData.length)]
        
        // استخراج 3 إجابات خاطئة عشوائية + الإجابة الصحيحة وخلطهم
        let allResponses = sportData.map(item => item.response)
        let wrongOptions = [...new Set(allResponses.filter(res => res !== selectedSport.response))]
            .sort(() => 0.5 - Math.random())
            .slice(0, 3)
        let choices = [...wrongOptions, selectedSport.response].sort(() => 0.5 - Math.random())

        sportGames.set(chatId, {
            currentSport: selectedSport,
            attempts: 2,
            timeoutId: setTimeout(() => {
                if (sportGames.has(chatId)) {
                    sportGames.delete(chatId)
                    let info = `❌ *انتهى الوقت!* ⏰\n💡 الإجابة الصحيحة كانت: *${selectedSport.response}*`
                    conn.reply(chatId, info, fkontak, rcanal)
                }
            }, gameTime)
        })

        let sportMedia = await prepareWAMessageMedia({ image: { url: SPORT_IMAGE } }, { upload: conn.waUploadToServer })

        const buttons = choices.map(choice => ({
            name: "quick_reply",
            buttonParamsJson: JSON.stringify({
                display_text: choice,
                id: `${usedPrefix + command} check_sport|${choice}|${selectedSport.response}`
            })
        }))
        buttons.push({ name: "quick_reply", buttonParamsJson: JSON.stringify({ display_text: "🚪 انسحاب", id: `${usedPrefix + command} انسحاب_رياضه` }) })

        const gameMsg = generateWAMessageFromContent(chatId, {
            viewOnceMessage: {
                message: {
                    interactiveMessage: proto.Message.InteractiveMessage.fromObject({
                        header: proto.Message.InteractiveMessage.Header.create({ hasMediaAttachment: true, imageMessage: sportMedia.imageMessage }),
                        body: proto.Message.InteractiveMessage.Body.create({ text: `⚽ *لعبة أسئلة كرة القدم*\n\nالسؤال:\n🎯 *${selectedSport.question}*\n\n⏳ الوقت: ${gameTime/1000} ثانية\n📌 اختر الإجابة الصحيحة من الأسفل 👇` }),
                        footer: proto.Message.InteractiveMessage.Footer.create({ text: "Sport Game" }),
                        nativeFlowMessage: proto.Message.InteractiveMessage.NativeFlowMessage.fromObject({ buttons })
                    })
                }
            }
        }, { quoted: m })

        await conn.relayMessage(chatId, gameMsg.message, { messageId: gameMsg.key.id })

    } catch (err) {
        console.error(err)
        sportGames.delete(chatId)
        let info = '❌ حدث خطأ أثناء تشغيل اللعبة، حاول مرة أخرى.'
        return conn.reply(chatId, info, fkontak, rcanal)
    }
}

handler.help = ['رياضه', 'رياضة', 'sport']
handler.tags = ['الـالـعـاب']
handler.command = ['رياضه'[

export default handler
